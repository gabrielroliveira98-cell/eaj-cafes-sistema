# Copie para .env (o comando "python manage.py setup" faz isso e gera a chave automaticamente).
# Nunca envie o arquivo .env para o Git.

# Chave usada para assinar a sessão. Precisa ser longa e aleatória.
SECRET_KEY=troque-esta-chave

# Caminho do banco SQLite, relativo à pasta do projeto.
DATABASE_PATH=instance/eaj.sqlite3

# Pasta com os frames da experiência da página inicial.
FRAMES_SOURCE=FRAMES VIDEO

# Use 1 em produção com HTTPS.
SESSION_COOKIE_SECURE=0

# Tamanho máximo de upload de imagens, em MB.
UPLOAD_MAX_MB=4

# Integração de pagamento. Vazio = nenhuma integração: o pedido é registrado
# como "aguardando pagamento" e o pagamento é combinado com a EAJ.
PAYMENT_PROVIDER=
